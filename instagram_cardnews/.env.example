# ══════════════════════════════════════════════════════════════════════
#  Instagram Brand CardNews Generator — Environment Variables Example
#  → 파일명을 .env 로 복사한 후 값을 채워주세요.
# ══════════════════════════════════════════════════════════════════════

# ─── Instagram 계정 ─────────────────────────────────────────────────
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# ─── Anthropic Claude API (AI 분석/카피라이팅) ───────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── 금감원 DART OpenAPI (한국 상장사 재무) ────────────────────────────
# 발급: https://opendart.fss.or.kr/
DART_API_KEY=your_dart_api_key

# ─── 네이버 검색 API ────────────────────────────────────────────────
# 발급: https://developers.naver.com/
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# ─── 아마존 Product Advertising API 5.0 ────────────────────────────
AMAZON_ACCESS_KEY=your_amazon_access_key
AMAZON_SECRET_KEY=your_amazon_secret_key
AMAZON_PARTNER_TAG=your_partner_tag
AMAZON_REGION=us-east-1

# ─── 프록시 (스크래핑 안정성용, 선택) ────────────────────────────────
# PROXY_URL=http://user:pass@proxy-host:port

# ─── 출력 경로 ─────────────────────────────────────────────────────
OUTPUT_DIR=./output
FONTS_DIR=./fonts

# ─── 스케줄러 설정 ─────────────────────────────────────────────────
# 포스팅 시간 (콤마 구분, 24h 형식)
POST_TIMES=09:00,18:00
TIMEZONE=Asia/Seoul
